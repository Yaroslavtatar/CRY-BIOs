# GEMINI_API_KEY: Optional, for AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical public URL (used for install script, profile links).
APP_URL="https://cbios.ru"

# BIO_BASE_DOMAIN: Base domain for user subdomains (name.cbios.ru).
BIO_BASE_DOMAIN="cbios.ru"

# ADMIN_PASSWORD: Admin panel password (required in production).
# ADMIN_PASSWORD="your_secure_password"

# BACKUP_RETAIN=5
# BACKUP_CRON_HOURS=24
# DISABLE_SCHEDULED_BACKUP=false
# BACKUP_MAX_MB=2048
# BACKUP_CHUNK_MB=4

# Discord (OAuth + presence). Redirect URI в Developer Portal: <APP_URL>/api/discord/oauth/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=
# DISCORD_API_BASE=https://discord.com/api/v10
# LANYARD_API_BASE=https://api.lanyard.rest/v1

# Cloudflare Worker cbios-edge — теперь только для импорта guns.lol (опционально)
# CBIOS_EDGE_URL=https://cbios-edge.your-subdomain.workers.dev

# Доп. origin для CORS через запятую (cbios.ru и cryteam.ru разрешены по умолчанию)
# CORS_ALLOWED_ORIGINS=https://cdn.example.com

# Media pipeline
# MEDIA_MAX_CONCURRENT=2
# MEDIA_ENABLE_AVIF=true
# MEDIA_ENABLE_DEDUP=true
# MEDIA_CDN_URL=https://cdn.cbios.ru

# Главная страница: данные репозитория с GitHub (кэшируются на сервере, токен клиенту не уходит).
# GITHUB_REPO=owner/name — другой репозиторий (например, ваш форк); GITHUB_REPO=off — скрыть живые данные GitHub.
# GITHUB_REPO=Yaroslavtatar/CRY-BIOs
# GITHUB_TOKEN нужен только если упираетесь в лимит 60 запросов/час на IP сервера (права не нужны, достаточно публичного доступа)
# GITHUB_TOKEN=

# Соцсети проекта на главной (показываются только заданные; принимаются https-ссылки на домен самой соцсети).
# SOCIAL_TELEGRAM_URL=https://t.me/your_channel
# SOCIAL_DISCORD_URL=https://discord.gg/your_invite
# SOCIAL_YOUTUBE_URL=
# SOCIAL_X_URL=
# SOCIAL_TIKTOK_URL=
# SOCIAL_VK_URL=
# SOCIAL_INSTAGRAM_URL=
# SOCIAL_TWITCH_URL=
